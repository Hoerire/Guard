<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270"
                android:startColor="#F6F9FF" android:centerColor="#F5F3FE" android:endColor="#EEF5FE"/>
        </shape>
    </item>
    <item android:width="360dp" android:height="360dp" android:left="-110dp" android:top="-120dp" android:gravity="top|left">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="180dp"
                android:startColor="#66B7D4FF" android:centerColor="#26B7D4FF" android:endColor="#00B7D4FF"/>
        </shape>
    </item>
    <item android:width="400dp" android:height="400dp" android:right="-120dp" android:top="130dp" android:gravity="top|right">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="200dp"
                android:startColor="#59E2C4F5" android:centerColor="#20E2C4F5" android:endColor="#00E2C4F5"/>
        </shape>
    </item>
    <item android:width="380dp" android:height="380dp" android:left="-70dp" android:bottom="-140dp" android:gravity="bottom|left">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="190dp"
                android:startColor="#66A8D8F2" android:centerColor="#22A8D8F2" android:endColor="#00A8D8F2"/>
        </shape>
    </item>
    <item android:width="280dp" android:height="280dp" android:right="-60dp" android:bottom="-60dp" android:gravity="bottom|right">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="140dp"
                android:startColor="#4DFFD9B0" android:centerColor="#1FFFD9B0" android:endColor="#00FFD9B0"/>
        </shape>
    </item>
</layer-list>